# Copy to terraform.tfvars (git-ignored). Use the same quota_project as infra/.
quota_project  = "REPLACE_WITH_SEED_PROJECT_ID"
model          = "REPLACE_WITH_ALLOWED_MODEL_ID" # T04 allowlist entry, without :predict
region         = "europe-west1"
deploy_agent_a = false
deploy_agent_b = false
deploy_agent_c = false # v2 C (T33, T34): needs infra/ swp_enabled + enable_v2_psci and tests/fixtures/agent_c/build.sh
deploy_agent_g = false # v2 B (T30, T31b, T32): needs infra/ enable_v2_gateway + tests/fixtures/gateway/{setup.sh,agent_g/build.sh}
# agent_c_short_attachment_name = false # set true if the deploy rejects the attachment path
