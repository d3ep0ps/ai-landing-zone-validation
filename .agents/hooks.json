{
  "lzv-permission-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|read_file|grep_search|find_by_name|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/permission_gate.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

